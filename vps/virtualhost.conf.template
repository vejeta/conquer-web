# Apache Virtual Host Configuration for Conquer Web on VPS
# Place this file in /etc/apache2/sites-available/DOMAIN_NAME.conf

# HTTP Virtual Host - Redirect to HTTPS and handle Let's Encrypt challenges
<VirtualHost *:80>
    ServerName DOMAIN_NAME
    DocumentRoot /var/www/html

    # Allow Let's Encrypt challenges
    <Directory "/var/www/html/.well-known">
        Require all granted
        AllowOverride None
        Options None
    </Directory>

    # Redirect everything else to HTTPS
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/\.well-known/acme-challenge/
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Logging
    ErrorLog ${APACHE_LOG_DIR}/conquer_error.log
    CustomLog ${APACHE_LOG_DIR}/conquer_access.log combined
</VirtualHost>

# HTTPS Virtual Host - Main Conquer Web Application
<VirtualHost *:443>
    ServerName DOMAIN_NAME

    # SSL Configuration
    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/DOMAIN_NAME/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/DOMAIN_NAME/privkey.pem

    # Modern SSL configuration
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
    SSLCipherSuite ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384
    SSLHonorCipherOrder off
    SSLSessionTickets off

    # Enhanced security headers
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-Content-Type-Options nosniff
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss:; font-src 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"

    # Hide server information
    ServerSignature Off

    # Landing page (static, public)
    DocumentRoot "/var/www/DOMAIN_NAME"

    # Game terminal: ttyd runs with base path /play
    RedirectMatch permanent ^/play$ /play/

    # Administrator page: /admin/ shows admin.html (the page itself holds
    # nothing private; the signed-in check is the <Location "/admin/"> below)
    RedirectMatch permanent ^/admin$ /admin/
    AliasMatch "^/admin/$" "/var/www/DOMAIN_NAME/admin.html"

    # Drop any client-supplied identity header so it cannot be forged
    # (the player account check for /play/ is at the end of this vhost)
    RequestHeader unset X-WEBAUTH-USER early

    # Enable rewrite engine for WebSocket upgrade
    RewriteEngine on

    # A browser sends the player's saved password along with a WebSocket that
    # any web page opens, so only the game's own page may open one: its
    # Origin must be this site (the test string is "origin|https://host",
    # equal halves pass)
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond "%{HTTP:Origin}|https://%{HTTP_HOST}" "!^(.+)\|\1$" [NC]
    RewriteRule ^/play/ - [F,L]

    # WebSocket upgrade handling
    RewriteCond %{HTTP:Upgrade} websocket [NC]
    RewriteCond %{HTTP:Connection} upgrade [NC]
    RewriteRule ^/play/(.*) "ws://127.0.0.1:7681/play/$1" [P,L]

    # Regular HTTP proxy
    ProxyPreserveHost On
    # Requests for a seat (web/signup.html): conquer-gate creates the account
    # (pending the administrator's approval, or approved with an invite
    # code); it is open, like the sign-up page
    ProxyPass /join/api/ http://127.0.0.1:7682/join/api/
    ProxyPassReverse /join/api/ http://127.0.0.1:7682/join/api/
    # Administrator page (/admin/): the gate answers only to accounts marked
    # "*" in the players file, see <Location "/admin/"> below
    ProxyPass /admin/api/ http://127.0.0.1:7682/admin/api/
    ProxyPassReverse /admin/api/ http://127.0.0.1:7682/admin/api/
    # Player account API: see <Location "/account/api/"> below
    ProxyPass /account/api/ http://127.0.0.1:7682/account/api/
    ProxyPassReverse /account/api/ http://127.0.0.1:7682/account/api/
    ProxyPass /play/ http://127.0.0.1:7681/play/
    ProxyPassReverse /play/ http://127.0.0.1:7681/play/

    # WebSocket proxy settings
    ProxyTimeout 3600

    <Directory "/var/www/DOMAIN_NAME">
        Options None
        AllowOverride None
        Require all granted
        # Pages, scripts and texts change with every update: browsers ask
        # for a newer copy each time (a short "not modified" when there is
        # none), so nobody sees a new page with old texts
        <FilesMatch "\.(html|js|css|json)$">
            Header set Cache-Control "no-cache"
        </FilesMatch>
    </Directory>

    # Public game status, written by the game container
    <Directory "/var/www/DOMAIN_NAME/status">
        # The website may also be published elsewhere (GitHub Pages) and
        # read the public game status from here
        Header always set Access-Control-Allow-Origin "*"
        Header always set Cache-Control "no-cache"
    </Directory>

    # Security: Block access to sensitive files
    <Files ~ "^\.(htaccess|htpasswd|git|env|log)">
        Require all denied
    </Files>

    # Block suspicious request patterns
    <LocationMatch "/(\.git|\.env|config|phpmyadmin)">
        Require all denied
    </LocationMatch>


    # Logging
    ErrorLog ${APACHE_LOG_DIR}/conquer_ssl_error.log
    CustomLog ${APACHE_LOG_DIR}/conquer_ssl_access.log combined
    # Failed sign-ins, for fail2ban (vps/fail2ban/): mod_auth_form answers a
    # wrong password with a redirect to /login.html?failed=1 and writes
    # nothing to the error log, so the access log line with the Location
    # header is the only trace. Only the sign-in posts are written here.
    LogFormat "%h %l - %t \"%r\" %>s \"%{Location}o\"" conquer_login
    SetEnvIf Request_URI "^/login/(do|long)$" conquer_login_post
    CustomLog ${APACHE_LOG_DIR}/conquer_login.log conquer_login env=conquer_login_post
    # Wrong current passwords and wrong recovery codes (the gate answers 403),
    # for fail2ban (vps/fail2ban/conquer-recover.conf). Logs are kept 7 days
    # (update-vps.sh installs /etc/logrotate.d/conquer-web).
    SetEnvIf Request_URI "^/(join/api/recover|account/api/(password|recovery))$" conquer_recover_post
    CustomLog ${APACHE_LOG_DIR}/conquer_recover.log conquer_login env=conquer_recover_post

    # Log format for monitoring
    LogFormat "%h %l %u %t \"%r\" %>s %O \"%{Referer}i\" \"%{User-Agent}i\"" combined

    # Sign-in: a page of the site (/login.html) and a session cookie, instead of
    # the browser's password window (mod_auth_form). Apache reads the same
    # account file as before. The cookie holds the account and the password
    # encrypted with the passphrase file (mod_session_crypto); it is
    # httponly, secure and same-site, and is not passed on to the game.
    # (These directives are not allowed outside a <Location>, so each one
    # repeats the common lines.)
    # The login form posts here (fields httpd_username, httpd_password,
    # httpd_location); a wrong password goes back to the page with failed=1.
    # /login/do gives a session cookie (gone when the browser closes);
    # /login/long, chosen by "Remember me", lasts 30 days.
    <Location "/login/do">
        SetHandler form-login-handler
        AuthType form
        AuthName "Conquer"
        AuthFormProvider file
        AuthUserFile "/etc/apache2/conquer-web.htpasswd"
        Session On
        SessionCookieName conquer_session path=/;httponly;secure;samesite=lax
        SessionCryptoPassphraseFile "/etc/apache2/conquer-web.session"
        Require all granted
        SessionMaxAge 0
        AuthFormLoginRequiredLocation "/login.html?failed=1&%{QUERY_STRING}"
        AuthFormLoginSuccessLocation "/play/"
    </Location>
    <Location "/login/long">
        SetHandler form-login-handler
        AuthType form
        AuthName "Conquer"
        AuthFormProvider file
        AuthUserFile "/etc/apache2/conquer-web.htpasswd"
        Session On
        SessionCookieName conquer_session path=/;httponly;secure;samesite=lax
        SessionCryptoPassphraseFile "/etc/apache2/conquer-web.session"
        Require all granted
        SessionMaxAge 2592000
        AuthFormLoginRequiredLocation "/login.html?failed=1&%{QUERY_STRING}"
        AuthFormLoginSuccessLocation "/play/"
    </Location>
    <Location "/logout">
        SetHandler form-logout-handler
        AuthType form
        AuthName "Conquer"
        AuthFormProvider file
        AuthUserFile "/etc/apache2/conquer-web.htpasswd"
        Session On
        SessionCookieName conquer_session path=/;httponly;secure;samesite=lax
        SessionCryptoPassphraseFile "/etc/apache2/conquer-web.session"
        Require all granted
        SessionMaxAge 1
        AuthFormLogoutLocation "/login.html?loggedout=1"
    </Location>

    # Administrator page and its API: the same accounts as the game; the gate
    # lets in only the ones marked "*" (manage-players.sh assign NAME --admin)
    <Location "/admin/">
        AuthType form
        AuthName "Conquer"
        AuthFormProvider file
        AuthUserFile "/etc/apache2/conquer-web.htpasswd"
        Session On
        SessionCookieName conquer_session path=/;httponly;secure;samesite=lax
        SessionCryptoPassphraseFile "/etc/apache2/conquer-web.session"
        # No SessionMaxAge here: the lifetime is the one the login gave
        # (/login/long: 30 days from the login, /login/do: the browser's
        # session), and the cookie is not rewritten at every request
        # The browser's cookie is not passed on to the game or the gate
        SessionCookieRemove On
        AuthFormLoginRequiredLocation "/login.html?next=%{escape:%{REQUEST_URI}}"
        Require valid-user
        RequestHeader set X-WEBAUTH-USER "%{REMOTE_USER}s"
        # Keep search engines out of the administration
        Header always set X-Robots-Tag "noindex, nofollow"
    </Location>

    # Player account (web/account.html, web/recover.html): the gate changes the
    # password and keeps the hash of the recovery code. /account/api/ is for the
    # signed-in player only (the gate takes the account from X-WEBAUTH-USER,
    # which Apache sets from the session after dropping any value a client
    # sent); /join/api/recover is open, like the sign-up page, and limited by
    # the gate (5 wrong codes an hour per address and per account)
    <Location "/account/api/">
        AuthType form
        AuthName "Conquer"
        AuthFormProvider file
        AuthUserFile "/etc/apache2/conquer-web.htpasswd"
        Session On
        SessionCookieName conquer_session path=/;httponly;secure;samesite=lax
        SessionCryptoPassphraseFile "/etc/apache2/conquer-web.session"
        # The lifetime is the one the login gave; the cookie is not passed on
        SessionCookieRemove On
        AuthFormLoginRequiredLocation "/login.html?next=/account.html"
        Require valid-user
        RequestHeader set X-WEBAUTH-USER "%{REMOTE_USER}s"
        Header always set X-Robots-Tag "noindex, nofollow"
    </Location>

    # Request bodies: the sign-up, account and administrator APIs take small
    # JSON (the gate allows 8 KB, 2 KB and 1 KB); Apache refuses more before it proxies
    <Location "/join/api/">
        LimitRequestBody 65536
    </Location>
    <Location "/admin/api/">
        LimitRequestBody 65536
    </Location>
    <Location "/account/api/">
        LimitRequestBody 65536
    </Location>

    # Player accounts: Apache authenticates every request to the terminal
    # (manage-players.sh edits the file) and tells ttyd who signed in.
    # KEEP THIS THE LAST <Location> OF THE VHOST: sections are merged in
    # order, so a later <Location /> with "Require all granted" would
    # silently remove the password from the game.
    <Location "/play/">
        AuthType form
        AuthName "Conquer"
        AuthFormProvider file
        AuthUserFile "/etc/apache2/conquer-web.htpasswd"
        Session On
        SessionCookieName conquer_session path=/;httponly;secure;samesite=lax
        SessionCryptoPassphraseFile "/etc/apache2/conquer-web.session"
        # No SessionMaxAge here: the lifetime is the one the login gave
        # (/login/long: 30 days from the login, /login/do: the browser's
        # session), and the cookie is not rewritten at every request
        # The browser's cookie is not passed on to the game or the gate
        SessionCookieRemove On
        AuthFormLoginRequiredLocation "/login.html?next=%{escape:%{REQUEST_URI}}"
        Require valid-user
        RequestHeader set X-WEBAUTH-USER "%{REMOTE_USER}s"
        # Keep search engines out of the game terminal
        Header always set X-Robots-Tag "noindex, nofollow"
    </Location>
</VirtualHost>

# Additional security configuration
<Directory />
    # Block known bad user agents and suspicious patterns
    SetEnvIfNoCase User-Agent "^(libwww|wget|python|perl|curl|PHP)" bad_bot
    SetEnvIfNoCase User-Agent "(bot|crawler|spider)" bad_bot
    # Search engines and link previews (chat apps, social networks) are welcome
    SetEnvIfNoCase User-Agent "(Googlebot|bingbot|DuckDuckBot|Twitterbot|facebookexternalhit|Discordbot|Slackbot|LinkedInBot|TelegramBot|WhatsApp|Mastodon)" !bad_bot

    # Allow legitimate browsers and game clients
    SetEnvIfNoCase User-Agent "(firefox|chrome|safari|edge|opera)" good_browser

    # Block requests with no user agent
    SetEnvIf User-Agent "^$" bad_bot

    # Basic bot blocking
    <RequireAll>
        Require all granted
        Require not env bad_bot
    </RequireAll>
</Directory>

# Limit request size (prevent large uploads)
LimitRequestBody 1048576

# Timeout settings
Timeout 60
KeepAliveTimeout 5

# The landing page and the guide are public and meant to be found; only the
# game terminal is kept out of search engines (see <Location "/play/">)
