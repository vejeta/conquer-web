# Off-site copies of the world, the accounts and the settings
# (offsite-backup.sh). Copy to config/backup.env and fill in.

# Where the copies go: user@host:/path over SSH (the other machine needs
# rsync), or a local directory such as another disk or a mounted share
BACKUP_TARGET="backup@my-other-machine:/srv/backups/conquer"

# How many copies the target keeps (one a day with --install-cron)
BACKUP_KEEP=30

# SSH key for the target: sudo ./offsite-backup.sh --setup-key makes it and
# prints the line to add to the other machine
BACKUP_SSH_KEY=/root/.ssh/conquer-backup
BACKUP_SSH_PORT=22

# Optional: encrypt the copies (they hold the settings and the account
# hashes). A file with one long password, readable by root only; keep the
# password somewhere else too, or the copies cannot be opened
#   sudo sh -c 'openssl rand -base64 32 > /root/.conquer-backup-password'
#   sudo chmod 600 /root/.conquer-backup-password
BACKUP_PASSWORD_FILE=
