From f7b6ee8f0e983f18b0f94915dfd21366e25f9cdb Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Juan=20Manuel=20M=C3=A9ndez=20Rey?= <vejeta@gmail.com>
Date: Mon, 2 Nov 2026 00:30:04 +0000
Subject: [PATCH 4/4] Add -A: add a player the administrator approved, without
 the super user password

conqrun -a asks for the super user (god) password once the game is past
turn LASTADD, so that on a multi-user host not just anybody with a shell
can add a nation to a running world. Hosts that run the game behind a
front end that decides who may found a nation (for example a web site
where the administrator approves each account) cannot use that prompt.

Add -A. It behaves like -a (same locks: update running, god logged in,
"add"), but at any turn it skips the password: the caller states that
the administrator already approved this player. The game itself already
handles late starts ("points added for starting late" in newlogin.c).

This does not weaken a container deployment: everything there runs as
the one game user, who can edit the world files directly, so the prompt
never protected the world from that user. Players have no shell; they
reach conqrun only through a script that runs the builder for an account
the administrator approved and only once per account. -a keeps asking.
---
 gpl-release/admin.c | 21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/gpl-release/admin.c b/gpl-release/admin.c
index 24e0e74..076c261 100644
--- a/gpl-release/admin.c
+++ b/gpl-release/admin.c
@@ -82,14 +82,14 @@ char **argv;
 	long time();
 	/* mflag = make world, a=add player, x=execute, p=print */
 	/* rflag = make world from read in files */
-	int mflag, aflag, xflag, rflag;
+	int mflag, aflag, xflag, rflag, Aflag;
 	char string[FILELTH];
 	extern char *optarg;
 	char defaultdir[BIGLTH],cq_opts[BIGLTH];
 	struct passwd *getpwnam(), *pwent;
 
 	umask (MASK);
-	mflag = aflag = xflag = rflag = 0;
+	mflag = aflag = xflag = rflag = Aflag = 0;
 	srand((unsigned) time((long *) 0));
 	strcpy(datadir,"");
 	strcpy(cq_opts,"");
@@ -155,7 +155,7 @@ char **argv;
 	}
 
 	/* process the command line arguments */
-	while((i=getopt(argc,argv,"maxr:d:"))!=EOF) switch(i){
+	while((i=getopt(argc,argv,"mAaxr:d:"))!=EOF) switch(i){
 	/* process the command line arguments */
 	case 'm':  /* make a new world*/
 		mflag++;
@@ -163,6 +163,10 @@ char **argv;
 	case 'a': /* anyone with password can add player*/
 		aflag++;
 		break;
+	case 'A': /* add a player the administrator already approved */
+		aflag++;
+		Aflag = 1;
+		break;
 	case 'x': /* execute (update) program*/
 		xflag++;
 		break;
@@ -182,9 +186,10 @@ char **argv;
 		strcpy(datadir, optarg);
 		break;
 	case '?': /*  print out command line arguments */
-		printf("Command line format: %s [-max -dDIR -rSCENARIO]\n",argv[0]);
+		printf("Command line format: %s [-mAax -dDIR -rSCENARIO]\n",argv[0]);
 		printf("\t-m          make a world\n");
 		printf("\t-a          add new player\n");
+		printf("\t-A          add a player the administrator approved (no super user password after turn %d)\n", LASTADD);
 		printf("\t-x          execute (update) program\n");
 		printf("\t-d DIR      to use play different game\n");
 		/* printf("\t-r SCENARIO read map while making a new world\n\t\t\tuses SCENARIO.ele, SCENARIO.veg, &  SCENARIO.nat\n"); */
@@ -298,7 +303,9 @@ char **argv;
 		printf("\n********************************************");
 		printf("\n*      PREPARING TO ADD NEW PLAYERS        *");
 		printf("\n********************************************\n");
-		if( TURN > LASTADD ){
+		if( TURN > LASTADD && Aflag ){
+			printf("player approved by the administrator: no super user password needed\n");
+		} else if( TURN > LASTADD ){
 			printf("more than %d turns have passed since game start!\n", LASTADD);
 			printf("permission of game administrator required\n");
 			if(strncmp(crypt(getpass("\nwhat is conquer super user password:"),SALT),ntn[0].passwd,PASSLTH)!=0)
@@ -380,8 +387,10 @@ char **argv;
 	printf("error: must specify an option\n");
 
 	/*  print out command line arguments */
-	printf("Command line format: %s [-max -dDIR]\n",argv[0]);
+	printf("Command line format: %s [-mAax -dDIR]\n",argv[0]);
 	printf("\t-a       add new player\n");
+	printf("\t-A       add a player the administrator approved (no super user\n");
+	printf("\t         password after turn %d)\n", LASTADD);
 	printf("\t-d DIR   to use play different game\n");
 	printf("\t-m       make a world\n");
 	printf("\t-x       execute (update) program\n");
