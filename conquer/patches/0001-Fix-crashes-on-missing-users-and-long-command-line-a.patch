diff --git a/gpl-release/misc.c b/gpl-release/misc.c
index b9b4b19..6436502 100644
--- a/gpl-release/misc.c
+++ b/gpl-release/misc.c
@@ -35,6 +35,29 @@
 #include "header.h"
 #include "data.h"
 #include "trade.h"
+#include <pwd.h>
+
+/*
+ * uid of a login name, or -1 when the system has no such user. The world
+ * may name users of another machine (the god nation's leader, LOGIN of a
+ * binary built elsewhere), and getpwnam() then returns NULL.
+ */
+long
+login_uid(name)
+char	*name;
+{
+	struct passwd *pw = getpwnam(name);
+	return(pw == NULL ? -1L : (long) pw->pw_uid);
+}
+
+/* login name of a uid, or "(unknown)" when the system has no such user */
+char *
+uid_name(uid)
+long	uid;
+{
+	struct passwd *pw = getpwuid((uid_t) uid);
+	return(pw == NULL ? "(unknown)" : pw->pw_name);
+}
 
